# OpenAI-compatible endpoint. Keep credentials here, never in Git.
IDEA_API_BASE=https://api.openai.com/v1
IDEA_API_KEY=
IDEA_MODEL=
# json_schema | json_object | text
IDEA_OUTPUT_MODE=json_object
# max_tokens | max_completion_tokens
IDEA_TOKEN_PARAMETER=max_tokens
IDEA_MAX_OUTPUT_TOKENS=3500
IDEA_DATA_DIR=data
